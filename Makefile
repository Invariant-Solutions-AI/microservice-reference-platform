.PHONY: build test test-race fmt format-check vet tidy run-edge run-orders license license-check pre-commit

build:
	go -C shared/observability build ./...
	go -C shared/service build ./...
	go -C services/edge build ./...
	go -C services/orders build ./...

test:
	go -C shared/observability test ./...
	go -C shared/service test ./...
	go -C services/edge test ./...
	go -C services/orders test ./...
	
test-race:
	go -C shared/observability test -race ./...
	go -C shared/service test -race ./...
	go -C services/edge test -race ./...
	go -C services/orders test -race ./...

fmt:
	gofmt -w shared services

format-check:
	pwsh -NoProfile -File scripts/check-format.ps1

vet:
	go -C shared/observability vet ./...
	go -C shared/service vet ./...
	go -C services/edge vet ./...
	go -C services/orders vet ./...

tidy:
	go -C shared/observability mod tidy
	go -C shared/service mod tidy
	go -C services/edge mod tidy
	go -C services/orders mod tidy

run-edge:
	go run ./services/edge/cmd

run-orders:
	go run ./services/orders/cmd

license:
	pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/license.ps1 -Fix

license-check:
	pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/license.ps1

pre-commit: format-check license-check tidy vet build test
